<?xml version="1.0" encoding="UTF-8"?>
<interface>

  <!-- Libraries -->
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <!-- Template -->
  <template class="SnapshotsSection" parent="GtkBox">
    <child>
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">automatic</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">24</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <!-- <property name="margin-top">24</property> -->
            <property name="margin-bottom">24</property>

            <child>
              <object class="RepositoryListView">
                <property name="title">Snapshots</property>
                <property name="item_class_name">Snapshot</property>
                <property name="add_button_title">Add snapshot</property>
                <property name="item_installation_class_name">SnapshotInstallation</property>
                <property name="item_icon">video-frame-svgrepo-com-symbolic</property>
                <property name="item_title_property_name">name</property>
                <property name="item_subtitle_property_name">short_details</property>
                <property name="preserve_item_order">True</property>
                <!-- <property name="item_status_property_name">status_indicator_values</property> -->
                <signal name="item-row-pressed" handler="on_item_row_pressed"/>
                <signal name="installation-row-pressed" handler="on_installation_row_pressed"/>
                <signal name="add-new-item-pressed" handler="on_add_new_item_pressed"/>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkListBox">
                    <property name="selection-mode">none</property>
                    <style>
                      <class name="boxed-list"/>
                    </style>
                    <child>
                      <object class="AdwSwitchRow" id="auto_clean_row">
                        <property name="title">Auto clean unused snapshots</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Only snapshots selected in project configuration and the newest snapshot are kept. Previous builds do not keep snapshots. Snapshots in use are kept until the operation finishes.</property>
                    <property name="xalign">0</property>
                    <property name="wrap">True</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <style>
                      <class name="caption"/>
                      <class name="dimmed"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkSeparator"/>
            </child>

            <child>
              <object class="GtkLabel">
                <property name="label">Snapshots are compressed copies of the Gentoo ebuild repository (.sqfs files), used by Catalyst when building stages. All stages of a project are built from the same snapshot.</property>
                <property name="halign">center</property>
                <property name="wrap">True</property>
                <property name="justify">fill</property>
                <attributes>
                  <attribute name="foreground" value="gray"/>
                </attributes>
              </object>
            </child>

          </object>
        </child>
      </object>
    </child>

  </template>
</interface>

