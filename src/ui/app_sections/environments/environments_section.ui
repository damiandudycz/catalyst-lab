<?xml version="1.0" encoding="UTF-8"?>
<interface>

  <!-- Libraries -->
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <!-- Template -->
  <template class="EnvironmentsSection" parent="GtkBox">
    <child>
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">automatic</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">24</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <!-- <property name="margin-top">24</property> -->
            <property name="margin-bottom">24</property>

            <child>
              <object class="AdwPreferencesGroup" id="host_runner_group">
                <property name="title">Runners</property>
                <property name="visible">False</property>
                <child>
                  <object class="AdwActionRow" id="host_runner_row">
                    <property name="title">Host</property>
                    <property name="subtitle">This Linux machine runs primary tools and loads toolsets directly.</property>
                    <child type="prefix">
                      <object class="GtkImage">
                        <property name="icon-name">computer-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="RepositoryListView" id="machines_list">
                <property name="title">VM runners</property>
                <property name="item_class_name">Runner</property>
                <property name="add_button_title">Add VM runner</property>
                <property name="item_installation_class_name">VMRunnerInstallation</property>
                <property name="item_icon">virtual-machine-symbolic</property>
                <property name="item_title_property_name">name</property>
                <property name="item_subtitle_property_name">short_details</property>
                <property name="description">Choose a runner's radio button to make it the default for actions that need one.</property>
                <property name="item_status_property_name">status_indicator_values</property>
                <signal name="item-row-pressed" handler="on_machine_row_pressed"/>
                <signal name="installation-row-pressed" handler="on_machine_installation_row_pressed"/>
                <signal name="add-new-item-pressed" handler="on_add_new_machine_pressed"/>
              </object>
            </child>

            <child>
              <object class="RepositoryListView">
                <property name="title">Toolsets</property>
                <property name="description">Choose a toolset's radio button to make it the default for actions that need one.</property>
                <property name="item_class_name">Toolset</property>
                <property name="add_button_title">Add toolset</property>
                <property name="item_installation_class_name">ToolsetInstallation</property>
                <property name="item_icon">toolbox-symbolic</property>
                <property name="item_title_property_name">name</property>
                <property name="item_subtitle_property_name">short_details</property>
                <property name="item_status_property_name">status_indicator_values</property>
                <property name="show_default_toolset">True</property>
                <signal name="item-row-pressed" handler="on_item_row_pressed"/>
                <signal name="installation-row-pressed" handler="on_installation_row_pressed"/>
                <signal name="add-new-item-pressed" handler="on_add_new_item_pressed"/>
              </object>
            </child>


            <child>
              <object class="GtkSeparator"/>
            </child>

            <child>
              <object class="GtkLabel" id="description_label">
                <property name="label">Toolsets are isolated Gentoo environments with tools needed to build stages, like Catalyst and QEMU. Each toolset is created from an official stage3 image and stored as a .squashfs file.</property>
                <property name="halign">fill</property>
                <property name="wrap">True</property>
                <property name="xalign">0</property>
                <attributes>
                  <attribute name="foreground" value="gray"/>
                </attributes>
              </object>
            </child>

          </object>
        </child>
      </object>
    </child>

  </template>
</interface>

