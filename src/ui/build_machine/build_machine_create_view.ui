<?xml version="1.0" encoding="UTF-8"?>
<interface>

  <!-- Libraries -->
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <!-- Template -->
  <template class="VMRunnerCreateView" parent="GtkBox">
    <child>
      <object class="WizardView" id="wizard_view">
        <signal name="is-page-ready-to-continue" handler="is_page_ready_to_continue"/>
        <signal name="begin-installation" handler="begin_installation"/>
        <property name="show_welcome_screen">True</property>
        <property name="welcome_screen_icon_name">virtual-machine-symbolic</property>
        <property name="welcome_screen_title">Create VM runner</property>
        <property name="welcome_screen_description">A VM runner provides a Linux execution environment for primary tools and loaded toolsets on macOS. It's a small Alpine Linux system created with Lima. Folders of Catalyst Lab are shared with it.</property>
        <property name="install_button_label">Create runner</property>

        <!-- Page 1: Configuration -->
        <child>
          <object class="GtkScrolledWindow" id="configuration_page">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox">
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="margin-top">4</property>
                <property name="margin-bottom">4</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">VM runner</property>
                    <property name="description">Lima is required, install it with Homebrew: brew install lima</property>
                    <child>
                      <object class="AdwEntryRow" id="name_row">
                        <property name="title">Name</property>
                        <signal name="changed" handler="on_name_changed"/>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title">Set as default runner</property>
                        <property name="subtitle">Use this runner by default for actions that need one</property>
                        <property name="activatable-widget">set_as_default_checkbox</property>
                        <child type="prefix">
                          <object class="GtkCheckButton" id="set_as_default_checkbox">
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="name_used_label">
                    <property name="label">This name is already used.</property>
                    <property name="visible">False</property>
                    <style>
                      <class name="error"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Resources</property>
                    <property name="description">The VM runner itself takes only a few hundred MB. While toolsets run, their working files are kept in a temporary workspace that grows as needed and is deleted when they finish. Builds need space for an extracted toolset, snapshot, and stage.</property>
                    <child>
                      <object class="AdwSpinRow" id="cpus_row">
                        <property name="title">CPUs</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">1</property>
                            <property name="upper">64</property>
                            <property name="step-increment">1</property>
                            <property name="value">4</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="memory_row">
                        <property name="title">Memory (GiB)</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">2</property>
                            <property name="upper">256</property>
                            <property name="step-increment">1</property>
                            <property name="value">8</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="swap_row">
                        <property name="title">Swap limit (GiB)</property>
                        <property name="subtitle">Used when builds need more memory, takes space only while used. 0 disables swap</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">512</property>
                            <property name="step-increment">4</property>
                            <property name="value">16</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="disk_row">
                        <property name="title">Working space limit (GiB)</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">20</property>
                            <property name="upper">2048</property>
                            <property name="step-increment">8</property>
                            <property name="value">64</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

      </object>
    </child>
  </template>
</interface>
