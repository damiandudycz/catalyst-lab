<?xml version="1.0" encoding="UTF-8"?>
<interface>

  <!-- Libraries -->
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <!-- Template -->
  <template class="ProjectBuildView" parent="GtkBox">

    <!-- Setup view -->
    <child>
      <object class="WizardView" id="wizard_view">
        <signal name="is-page-ready-to-continue" handler="is_page_ready_to_continue"/>
        <signal name="begin-installation" handler="begin_installation"/>
        <property name="show_welcome_screen">True</property>
        <property name="welcome_screen_icon_name">sledgehammer-svgrepo-com-symbolic</property>
        <property name="welcome_screen_title">Build Stages</property>
        <property name="welcome_screen_description">Build selected stages of the project with Catalyst. Parent stages are reused from their latest builds, or built too when they don't have any.</property>
        <property name="install_button_label">Start build</property>

        <!-- Page 1: Toolset -->
        <child>
          <object class="GtkScrolledWindow" id="toolset_page">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox">
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="margin-top">4</property>
                <property name="margin-bottom">4</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="ItemSelectionView" id="toolset_selection_view">
                    <property name="title">Toolset</property>
                    <property name="description">The project-selected toolset is preselected when available. Catalyst is required; QEMU is also required when the project architecture needs emulation.</property>
                    <property name="item_icon">toolbox-symbolic</property>
                    <property name="item_title_property_name">name</property>
                    <property name="item_subtitle_property_name">short_details</property>
                    <property name="item_status_property_name">status_indicator_values</property>
                    <property name="autoselect_default">True</property>
                    <signal name="is-item-selectable" handler="is_toolset_selectable"/>
                    <signal name="is-item-usable" handler="is_toolset_usable"/>
                    <signal name="setup-items-monitoring" handler="setup_toolset_monitoring"/>
                  </object>
                </child>
                <child>
                  <object class="ItemSelectionView" id="runner_selection_view">
                    <property name="title">Runner</property>
                    <property name="description">Runner used to execute Catalyst and build the selected stages. The default runner is selected when available.</property>
                    <property name="item_class_name">Runner</property>
                    <property name="include_host_runner">True</property>
                    <property name="item_icon">virtual-machine-symbolic</property>
                    <property name="item_title_property_name">name</property>
                    <property name="item_subtitle_property_name">short_details</property>
                    <property name="item_status_property_name">status_indicator_values</property>
                    <property name="autoselect_default">True</property>
                    <signal name="is-item-selectable" handler="is_runner_selectable"/>
                    <signal name="is-item-usable" handler="is_runner_usable"/>
                    <signal name="setup-items-monitoring" handler="setup_runner_monitoring"/>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Page 2: Stages selection -->
        <child>
          <object class="GtkScrolledWindow" id="stages_page">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox">
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="margin-top">4</property>
                <property name="margin-bottom">4</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="AdwPreferencesGroup" id="stages_group">
                    <property name="title">Stages</property>
                    <property name="description">Select stages to build. Parent stages are reused from their latest build, or built too if they don't have one.</property>
                    <property name="header-suffix">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkButton">
                            <property name="label">Select all</property>
                            <property name="valign">center</property>
                            <signal name="clicked" handler="on_select_all_clicked"/>
                            <style>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="label">Clear</property>
                            <property name="valign">center</property>
                            <signal name="clicked" handler="on_clear_clicked"/>
                            <style>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Page 3: Snapshot -->
        <child>
          <object class="GtkScrolledWindow" id="snapshot_page">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox">
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="margin-top">4</property>
                <property name="margin-bottom">4</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="ItemSelectionView" id="snapshot_selection_view">
                    <property name="title">Snapshot</property>
                    <property name="description">Snapshot of the Gentoo ebuild repository used by this build. Snapshot of the project is selected by default. Get latest generates a new snapshot with the selected toolset before building.</property>
                    <property name="item_icon">video-frame-svgrepo-com-symbolic</property>
                    <property name="item_title_property_name">name</property>
                    <property name="item_subtitle_property_name">short_details</property>
                    <property name="autoselect_default">False</property>
                    <signal name="is-item-selectable" handler="is_item_selectable"/>
                    <signal name="is-item-usable" handler="is_item_usable"/>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Page 4: Summary -->
        <child>
          <object class="GtkScrolledWindow" id="summary_page">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox">
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="margin-top">4</property>
                <property name="margin-bottom">4</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="AdwPreferencesGroup" id="build_order_group">
                    <property name="title">Build order</property>
                    <property name="description">Stages are built in this order. When a stage fails, stages depending on it are skipped, other branches are still built.</property>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="reused_group">
                    <property name="title">Reused builds</property>
                    <property name="description">Previous builds used as seeds.</property>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Cleanup</property>
                    <property name="description">Runs after each successful stage build.</property>
                    <child>
                      <object class="AdwSwitchRow" id="cleanup_previous_builds_row">
                        <property name="title">Remove previous successful builds</property>
                        <property name="subtitle">After each stage succeeds, remove its older successful builds. Failed builds are kept.</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Location</property>
                    <child>
                      <object class="AdwActionRow" id="snapshot_row">
                        <property name="title">Snapshot</property>
                        <property name="icon-name">video-frame-svgrepo-com-symbolic</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="runs_on_row">
                        <property name="title">Runs on</property>
                        <property name="icon-name">toolbox-symbolic</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="location_row">
                        <property name="title">Builds are stored in</property>
                        <property name="subtitle-selectable">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Page 5: Generated files -->
        <child>
          <object class="GtkScrolledWindow" id="generated_files_page">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox">
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="margin-top">4</property>
                <property name="margin-bottom">12</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Generated build files</property>
                    <property name="description">Preview uses the selected toolset, build stages, and snapshot. The spec and overlays are generated on this computer; catalyst.conf is created inside the toolset when the build runs. Files are generated again when the build starts, and seed paths or defaults that depend on a newly generated latest snapshot are resolved then.</property>
                    <child>
                      <object class="AdwActionRow" id="generated_files_location_row">
                        <property name="title">Preview location</property>
                        <property name="subtitle-selectable">True</property>
                        <property name="visible">False</property>
                        <child type="suffix">
                          <object class="GtkButton">
                            <property name="label">Browse all</property>
                            <property name="valign">center</property>
                            <signal name="clicked" handler="on_browse_all_generated_files"/>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="generated_files_group">
                    <property name="title">Stages</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

  </template>
</interface>
