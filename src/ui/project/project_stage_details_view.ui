<?xml version="1.0" encoding="UTF-8"?>
<interface>

  <!-- Libraries -->
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <!-- Template -->
  <template class="ProjectStageDetailsView" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkOverlay">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkBox">
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">4</property>
            <property name="margin-bottom">24</property>
            <property name="orientation">vertical</property>
            <property name="spacing">24</property>
            <child>
              <object class="AdwPreferencesGroup" id="basic_config_pref_group">
                <property name="title">Stage and template</property>
                <child>
                  <object class="AdwEntryRow" id="stage_name_row">
                    <property name="title">Stage name</property>
                    <property name="show-apply-button">True</property>
                    <signal name="apply" handler="on_stage_name_activate"/>
                    <signal name="changed" handler="on_stage_name_changed"/>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow" id="name_used_row">
                    <property name="title">This stage name is already used.</property>
                    <style>
                      <class name="caption-heading"/>
                      <class name="error"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="architecture_pref_group">
                <property name="title">Architecture</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="release_pref_group">
                <property name="title">Release output</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="packages_pref_group">
                <property name="title">Package management</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="kernels_pref_group">
                <property name="title">Kernels</property>
                <property name="visible">False</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="stage_setup_pref_group">
                <property name="title">Stage system setup</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="live_image_pref_group">
                <property name="title">Live image output</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="live_system_pref_group">
                <property name="title">Live system setup</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="build_behavior_pref_group">
                <property name="title">Portage and build behavior</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="other_pref_group">
                <property name="title">Other</property>
                <property name="description">Additional Catalyst settings without a dedicated group.</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="row_warnings_group">
                <property name="visible">False</property>
                <child>
                  <object class="AdwActionRow" id="row_warnings_row">
                    <property name="title">Some stage settings could not be loaded</property>
                    <child type="prefix">
                      <object class="GtkImage">
                        <property name="icon-name">danger-triangle-svgrepo-com-symbolic</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="warning"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="unsupported_options_group">
                <property name="title">Unsupported saved options</property>
                <property name="description">These values are saved in the stage but are not recognized by the selected Catalyst toolset. They are preserved and will not be removed.</property>
                <property name="visible">False</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="build_requirements_group">
                <property name="title">Build requirements</property>
                <property name="visible">False</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="warnings_empty_group">
                <property name="title">Warnings</property>
                <property name="visible">False</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title">No warnings found</property>
                    <property name="subtitle">All visible stage settings are valid for the selected toolset and stage.</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
              </object>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox" id="loading_indicator">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="visible">False</property>
            <property name="can-target">False</property>
            <style><class name="card"/><class name="toolbar"/></style>
            <child><object class="AdwSpinner"><property name="width-request">32</property><property name="height-request">32</property></object></child>
            <child><object class="GtkLabel"><property name="label">Loading stage settings…</property><style><class name="dim-label"/></style></object></child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child><object class="GtkSeparator"/></child>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">0</property>
            <property name="margin-bottom">0</property>
            <property name="valign">center</property>
            <property name="height-request">32</property>
            <style>
              <class name="toolbar"/>
            </style>
            <child>
              <object class="GtkLabel" id="toolset_footer_label">
                <property name="hexpand">True</property>
                <property name="valign">center</property>
                <property name="xalign">0</property>
                <property name="ellipsize">end</property>
                <property name="label">Catalyst toolset</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="delete_button">
                <property name="tooltip-text">Delete stage</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel"><property name="label">Delete stage</property></object>
                </child>
                <style>
                  <class name="flat"/>
                  <class name="stage-delete-button"/>
                </style>
                <signal name="clicked" handler="on_delete_clicked"/>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>

