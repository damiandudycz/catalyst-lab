<?xml version="1.0" encoding="UTF-8"?>
<interface>

  <!-- Libraries -->
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <!-- Template -->
  <template class="ProjectDetailsView" parent="GtkBox">
    <property name="orientation">vertical</property>

    <!-- Switcher -->
    <child>
      <object class="AdwViewSwitcher" id="switcher">
        <property name="margin-start">24</property>
        <property name="margin-end">24</property>
        <property name="margin-bottom">12</property>
        <property name="stack">stack</property>
        <property name="policy">wide</property>
      </object>
    </child>
    <!-- [END] Switcher -->

    <!-- Content container -->
    <child>
      <object class="AdwViewStack" id="stack">
        <property name="vexpand">True</property>

        <!-- Pages []: -->

        <!-- Page 1 container -->
        <child>
          <object class="AdwViewStackPage">
            <property name="name">stages</property>
            <property name="title">Stages</property>
            <property name="icon-name">checklist-minimalistic-svgrepo-com-symbolic</property>
            <property name="child">
              <object class="GtkStack" id="stage_content_stack">
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="visible-child-name">compact</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">compact</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">automatic</property>
                        <property name="vscrollbar-policy">automatic</property>
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <child>
                          <object class="StagesTreeView" id="stages_compact_view">
                            <signal name="stage-selected" handler="on_stage_selected"/>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">full</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">automatic</property>
                        <property name="vscrollbar-policy">automatic</property>
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <child>
                          <object class="StagesTreeView" id="stages_full_view">
                            <signal name="stage-selected" handler="on_stage_selected"/>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">list</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vscrollbar-policy">automatic</property>
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <child>
                          <object class="StagesListView" id="stages_list_view">
                            <property name="hexpand">True</property>
                            <property name="vexpand">True</property>
                            <signal name="stage-selected" handler="on_stage_selected"/>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <!-- [END] Page 1 container -->

        <!-- Page 2 container -->
        <child>
          <object class="AdwViewStackPage">
            <property name="title">Configuration</property>
            <property name="icon-name">settings-svgrepo-com-symbolic</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="margin-start">24</property>
                    <property name="margin-end">24</property>
                    <!-- <property name="margin-top">24</property> -->
                    <property name="margin-bottom">24</property>
                    <child>
                      <object class="ItemSelectionExpanderRow" id="releng_selection_view">
                        <property name="title">Releng directory</property>
                        <property name="item_class_name">RelengDirectory</property>
                        <property name="item_icon">book-minimalistic-svgrepo-com-symbolic</property>
                        <property name="item_title_property_name">name</property>
                        <property name="item_subtitle_property_name">short_details</property>
                        <property name="item_status_property_name">status_indicator_values</property>
                        <signal name="is-item-selectable" handler="is_item_selectable"/>
                        <signal name="is-item-usable" handler="is_item_usable"/>
                        <signal name="setup-items-monitoring" handler="setup_items_monitoring"/>
                      </object>
                    </child>
                    <child>
                      <object class="ItemSelectionExpanderRow" id="snapshot_selection_view">
                        <property name="title">Snapshot</property>
                        <property name="item_class_name">Snapshot</property>
                        <property name="item_icon">video-frame-svgrepo-com-symbolic</property>
                        <property name="item_title_property_name">name</property>
                        <property name="item_subtitle_property_name">short_details</property>
                        <property name="item_status_property_name">status_indicator_values</property>
                        <signal name="is-item-selectable" handler="is_item_selectable"/>
                        <signal name="is-item-usable" handler="is_item_usable"/>
                        <signal name="setup-items-monitoring" handler="setup_items_monitoring"/>
                      </object>
                    </child>
                    <child>
                      <object class="ItemSelectionExpanderRow" id="arch_selection_view">
                        <property name="title">Architecture</property>
                        <property name="item_icon">cursor-square-symbolic</property>
                        <property name="item_title_property_name">name</property>
                        <signal name="is-item-selectable" handler="is_item_selectable"/>
                        <signal name="is-item-usable" handler="is_item_usable"/>
                      </object>
                    </child>
                    <child>
                      <object class="ItemSelectionExpanderRow" id="packages_selection_view">
                        <property name="title">Binary packages</property>
                        <property name="item_class_name">PackagesDirectory</property>
                        <property name="item_icon">archive-minimalistic-svgrepo-com-symbolic</property>
                        <property name="item_title_property_name">name</property>
                        <property name="item_subtitle_property_name">short_details</property>
                        <property name="item_status_property_name">status_indicator_values</property>
                        <property name="display_none">True</property>
                        <property name="none_title">None</property>
                        <property name="none_subtitle">Packages are kept in builds of project, not shared</property>
                        <signal name="is-item-selectable" handler="is_item_selectable"/>
                        <signal name="is-item-usable" handler="is_item_usable"/>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <!-- [END] Page 2 container -->

        <!-- Page 3 container -->
        <child>
          <object class="AdwViewStackPage">
            <property name="title">Information</property>
            <property name="icon-name">question-circle-svgrepo-com-symbolic</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">24</property>
                    <property name="margin-start">24</property>
                    <property name="margin-end">24</property>
                    <!-- <property name="margin-top">24</property> -->
                    <property name="margin-bottom">24</property>
                    <child>
                      <object class="GitDirectoryDetailsView" id="directory_details_view">
                        <property name="manager_class_name">ProjectManager</property>
                        <property name="update_class_name">ProjectUpdate</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <!-- [END] Page 3 container -->

      </object>
    </child>
    <!-- [END] Content container -->

    <!-- One shared action panel below the Stages tab. -->
    <child>
      <object class="GtkBox" id="source_banner">
        <property name="orientation">vertical</property>
        <property name="visible">False</property>
        <child><object class="GtkSeparator"/></child>
        <child>
          <object class="GtkBox" id="stage_actions">
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <style><class name="project-actions-panel"/></style>
            <child>
              <object class="GtkBox" id="build_actions_row">
                <property name="orientation">horizontal</property>
                <property name="spacing">12</property>
                <property name="homogeneous">True</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <child>
                  <object class="GtkButton" id="add_stage_row">
                    <property name="hexpand">True</property>
                    <signal name="clicked" handler="on_add_stage_activated"/>
                    <style><class name="suggested-action"/><class name="project-action-button"/></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">center</property>
                        <child><object class="GtkImage"><property name="icon-name">list-add-symbolic</property></object></child>
                        <child><object class="GtkLabel"><property name="label">Add stage</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="builds_row">
                    <property name="hexpand">True</property>
                    <signal name="clicked" handler="on_builds_activated"/>
                    <style><class name="project-action-button"/></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">center</property>
                        <child><object class="GtkImage"><property name="icon-name">box-minimalistic-svgrepo-com-symbolic</property></object></child>
                        <child><object class="GtkLabel"><property name="label">Builds list</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="build_row">
                    <property name="hexpand">True</property>
                    <signal name="clicked" handler="on_build_activated"/>
                    <style><class name="suggested-action"/><class name="project-action-button"/></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">center</property>
                        <child><object class="GtkImage"><property name="icon-name">sledgehammer-svgrepo-com-symbolic</property></object></child>
                        <child><object class="GtkLabel" id="build_row_label"><property name="label">Create build</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="build_progress_row">
                    <property name="visible">False</property>
                    <property name="hexpand">True</property>
                    <signal name="clicked" handler="on_build_progress_activated"/>
                    <style><class name="project-action-button"/></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">center</property>
                        <child><object class="GtkImage"><property name="icon-name">checklist-minimalistic-svgrepo-com-symbolic</property></object></child>
                        <child><object class="GtkLabel"><property name="label">Show build progress</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="height-request">32</property>
                <property name="valign">center</property>
                <style><class name="toolbar"/></style>
                <child>
                  <object class="GtkButton" id="source_button">
                    <property name="hexpand">False</property>
                    <property name="valign">center</property>
                    <signal name="clicked" handler="_on_update_source_clicked"/>
                    <style><class name="flat"/><class name="caption"/><class name="stage-toolset-change-button"/></style>
                    <child>
                      <object class="GtkLabel" id="source_button_label">
                        <property name="xalign">0</property>
                        <property name="ellipsize">end</property>
                        <style><class name="dim-label"/><class name="caption"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child><object class="GtkLabel"><property name="hexpand">True</property></object></child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

  </template>
</interface>

