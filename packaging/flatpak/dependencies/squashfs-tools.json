{
    "name": "squashfs-tools",
    "buildsystem": "simple",
    "build-commands": [
        "make -C squashfs-tools -j${FLATPAK_BUILDER_N_JOBS} GZIP_SUPPORT=1 XZ_SUPPORT=1 LZ4_SUPPORT=1 ZSTD_SUPPORT=1 LZO_SUPPORT=0",
        "install -Dm755 squashfs-tools/mksquashfs ${FLATPAK_DEST}/bin/mksquashfs",
        "install -Dm755 squashfs-tools/unsquashfs ${FLATPAK_DEST}/bin/unsquashfs"
    ],
    "sources": [
        {
            "type": "archive",
            "url": "https://github.com/plougher/squashfs-tools/archive/refs/tags/4.7.5.tar.gz",
            "sha256": "547b7b7f4d2e44bf91b6fc554664850c69563701deab9fd9cd7e21f694c88ea6"
        }
    ]
}
