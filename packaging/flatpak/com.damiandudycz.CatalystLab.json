{
    "id" : "com.damiandudycz.CatalystLab",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "command" : "catalystlab",
    "finish-args" : [
        "--talk-name=org.freedesktop.Flatpak",
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--device=kvm",
        "--filesystem=host:ro",
        "--filesystem=home",
        "--filesystem=xdg-run/catalystlab-root-helper:create",
        "--filesystem=/tmp/catalystlab:create",
        "--filesystem=/var/tmp/catalystlab:create"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        "dependencies/python3-requests.json",
        "dependencies/squashfs-tools.json",
        "dependencies/bwrap.json",
        {
            "name" : "catalystlab",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "--libdir=lib"
            ],
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "../..",
                    "skip" : [
                        ".git",
                        ".build",
                        ".build-flatpak",
                        ".build-macos",
                        ".build-macos-app",
                        ".flatpak-builder",
                        ".claude",
                        "dist"
                    ]
                }
            ]
        }
    ]
}
